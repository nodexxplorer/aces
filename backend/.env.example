# ============================================
# ACES Zone Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Database (Required)
# The restricted runtime role, never a superuser or the table owner: row-level
# security (department isolation) does not apply to those, and the server
# refuses to start as one. Create the role with `make runtime-role`
# (deploy/postgres/runtime-role.sql). See docs/multi-tenancy.md.
DB_SOURCE=postgresql://aces_app:your_secure_password@localhost:5432/aces_zone?sslmode=disable
# NOTE: Use sslmode=require (or sslmode=verify-full) in production
# Owner-level commands (migrations, runtime-role, cmd/tenant) need the migration
# owner's connection string. Pass it on the command line for that command only:
#   DB_SOURCE=postgresql://aces_user:...@localhost:5432/aces_zone?sslmode=disable make migrate-up

# Departments (multi-tenancy). Each department is a tenant with its own accounts.
# Department used when a request names none. Mobile clients rely on it.
DEFAULT_TENANT_SLUG=uniuyo-ce
# Connections each department's pool may hold. Total connections are roughly
# (departments in use x this value) + 4, so size Postgres max_connections to match.
DB_MAX_CONNS_PER_TENANT=4
# Development only: allow a role that bypasses row-level security (a superuser,
# BYPASSRLS, or a table owner). With it set, departments are NOT isolated from
# one another. Never set it in a shared or production environment.
DB_ALLOW_RLS_BYPASS=false

# Server (Required)
SERVER_ADDRESS=0.0.0.0:8080

# JWT (Required - must be at least 32 characters)
JWT_SECRET=change_this_to_a_random_string_at_least_32_chars

# JWT Token Durations (in minutes)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=10080

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://aces-ivory.vercel.app

# Admin Seeding (Required for seed_admin)
# seed_admin creates this admin in DEFAULT_TENANT_SLUG, or in the department
# named with -tenant: make seed-admin ARGS="-tenant unilag-ce". Run it with the
# runtime role's DB_SOURCE. It generates a separate password for each
# department and prints it once. Do not set ADMIN_PASSWORD: seed_admin refuses it.
ADMIN_EMAIL=admin@aces.zone

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# File Storage
STORAGE_LOCAL_PATH=./uploads

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=

# SMTP Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aces.zone
SMTP_MOCK=true

# Frontend public URL (used for Paystack callback redirect)
# Set to your deployed frontend URL in production (e.g. https://aces.zone)
FRONTEND_PUBLIC_URL=http://localhost:5173
# Where the API is reachable from outside, for logo links in emails. Defaults to
# FRONTEND_PUBLIC_URL, which is right when one host serves both.
# API_PUBLIC_URL=http://localhost:8080

# Push notifications
PUSH_MOCK=true
# Web Push (VAPID) — generate once with `go run` against
# webpush-go's GenerateVAPIDKeys(), then keep these stable across restarts
# (rotating them invalidates every existing browser subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@aces.zone

# Environment (development | production)
ENVIRONMENT=development

# Gemini AI (optional — powers the AI Assistant chatbot beyond its built-in
# rule-based answers). Leave blank to run on rules only.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_FALLBACK_ENABLED=true
