# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time by Expo.
# A phone on Expo Go can't reach "localhost" (that's the phone itself) — it
# needs your dev machine's LAN IP. Update this if your machine's IP changes
# or you're on a different network; run `hostname -I` (Linux) to check.
EXPO_PUBLIC_API_URL=http://192.168.1.219:8080/api/v1
